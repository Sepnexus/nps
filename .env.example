# Database
DATABASE_URL=postgres://vault:vault@localhost:5433/vault

# Auth
SESSION_SECRET=change-me-to-a-32-char-random-string

# OpenAI — see https://platform.openai.com/docs/models for current model IDs.
# gpt-5 is multimodal (handles both chat and images), so the same model serves
# the assistant chat and the receipt OCR.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5

# Storage
RECEIPT_STORAGE_DIR=./storage/receipts

# App
NEXT_PUBLIC_APP_NAME=Vault
TIMEZONE=Asia/Kolkata
CURRENCY=INR
